<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect www.dvanalyticsmds.com to dvanalyticsmds.com
  RewriteCond %{HTTP_HOST} ^www\.dvanalyticsmds\.com$ [NC]
  RewriteRule ^(.*)$ https://dvanalyticsmds.com/$1 [L,R=301]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
